# JARVIS Core Environment Variables

# LLM Providers
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here_if_using_fallback

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_env_here
PINECONE_INDEX_NAME=personal_kb

# Communication (Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Redis (Working Memory)
REDIS_URL=redis://localhost:6379

# Agent Specific APIs (Optional, fill as needed)
# Business Agent
SHOPIFY_API_KEY=
# Security Agent
HAVEIBEENPWNED_API_KEY=
# Content Agent
BUFFER_API_KEY=
# Voice
ELEVENLABS_API_KEY=