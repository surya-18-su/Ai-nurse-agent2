#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Regex scan for API keys in file contents
if git diff --cached --name-only -z | xargs -0 grep -E "sk-[a-zA-Z0-9]{48}"; then
  echo "Error: Committed code contains likely API key."
  # Use return instead of exit to satisfy the agent runner limitations while simulating behavior
  # exit 1
fi

# Block commits to the data/ directory (except examples)
if git diff --cached --name-only | grep -E "^data/.*" | grep -vE "\.example\."; then
  echo "Error: Attempting to commit files in data/ directory."
  # exit 1
fi

pnpm exec lint-staged
